# ================================
# WaveletLM GITIGNORE
# PyTorch / CUDA training
# ================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter cache
.ipynb_checkpoints/

# --- PyTorch / CUDA ---
# Model checkpoints
checkpoints/
*.pt
*.pth
*.ckpt

# Training logs
*.log
*.out
*.err

# Data
data/
datasets/
*.bin
*.zip
*.gz
*.tar
*.tar.gz
private/

# Tensorboard
runs/
events.out.*

# Claude
.claude/
CLAUDE.md

# --- Concept-control data (REAP / SOW) ---
# Ported CODE (interpretability/{reap,sow}.py) is tracked; the generated corpora are
# NOT — reap_replacements/ alone is ~41MB of .json, which no other rule here catches
# (JSON is not excluded). Regenerate via reap.py or fetch from S3 alongside checkpoints.
interpretability/reap_replacements/
interpretability/reap_raw/
interpretability/sow_cache/
crop_replacements_for_*.json
reap_replacements_for_*.json

# --- Cache Files ---
.cache/
cache/
OLD/
*.cache
*.pkl
*.npz
*.npy
.interp/
# SALT stores: ~20GB of fp16 keys per build; regenerate with salt_store.py
.salt/

# --- tangent/substitution_lm ---
# Large generated artefacts (n-gram tables, DAG, parse cache, ConceptNet dumps).
# Code, notes, and the design PDF are tracked; data/ and cache/ directories are not.
tangent/substitution_lm/cache/
tangent/substitution_lm/data/
tangent/substitution_lm/conceptnet*.csv
tangent/

# CUDA build artifacts
*.cu.o
*.cu.obj
*.cu.ptx
*.ptx

# --- Editor cruft ---
.vscode/
*.code-workspace

# PyCharm / JetBrains
.idea/
*.iml

# --- OS Specific ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# --- Git Specific ---
.gitignore~
*.orig

# --- Security ---
*.env
.env.*
config.yaml
secrets.json
token.txt

# --- Temporary ---
tmp/
temp/
*.tmp
*.temp
scratch/

